    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.modules.platform</depends>
    <!-- JCEF moved from the platform classloader into this bundled plugin in 2026.2 (build 262).
         Keep the dependency optional because older supported IDEs expose JCEF directly from the platform. -->
    <depends optional="true">com.intellij.modules.jcef</depends>
    <depends>org.jetbrains.plugins.terminal</depends>
    
    <!-- Extension points defined by the plugin.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <extensions defaultExtensionNs="com.intellij">
        <projectService serviceImplementation="org.zoocode.jetbrains.plugin.WecoderPluginService"/>
        <postStartupActivity implementation="org.zoocode.jetbrains.plugin.WecoderPlugin"/>
        <editorFactoryListener implementation="org.zoocode.jetbrains.editor.EditorListener"/>
        <toolWindow factoryClass="org.zoocode.jetbrains.ui.ZooCodeJetBrainsToolWindowFactory"
                    id="Zoo Code JetBrains"
                    secondary="true"
                    icon="/icons/zoo-logo.svg"
                    anchor="right" />
        <notificationGroup id="Zoo Code JetBrains"
                           displayType="BALLOON"/>
    </extensions>

    <extensions defaultExtensionNs="org.jetbrains.plugins.terminal">
        <localTerminalCustomizer implementation="org.zoocode.jetbrains.terminal.WeCoderTerminalCustomizer"/>
    </extensions>

    <actions>
        <!-- Dynamic toolbar group - buttons will be populated based on current extension -->
        <group id="WecoderToolbarGroup">
            <group id="ZooCodeJetBrains.DynamicExtensionActions"
                   class="org.zoocode.jetbrains.extensions.ui.actions.DynamicExtensionActionsGroup"
                   text="Extension Actions"
                   description="Dynamic extension-specific actions" />
        </group>

        <group id="ZooCodeJetBrains.RightClickMenu" text="Zoo Code" description="Zoo Code AI Assistant"  icon="/icons/zoo-logo.svg" popup="true">
            <group id="ZooCodeJetBrains.RightClick.Chat" class="org.zoocode.jetbrains.extensions.ui.contextmenu.DynamicExtensionContextMenuGroup"
                   text="Extension Actions" description="Dynamic extension-specific context menu actions"/>
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>
        </group>


        <!-- Right-click menu for extension-specific actions -->
        <group id="ZooCodeJetBrains.RightClick.ExtensionActions" text="Extension Actions" description="Extension-specific actions">
            <group id="ZooCodeJetBrains.RightClick.DynamicExtensionActions"
                   class="org.zoocode.jetbrains.extensions.ui.actions.DynamicExtensionActionsGroup"
                   text="Extension Actions"
                   description="Dynamic extension-specific actions" />
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </group>

        <!-- Main menu integration -->
        <group id="ZooCodeJetBrains.MainMenu" text="Zoo Code" description="Zoo Code AI Assistant">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <group id="ZooCodeJetBrains.MainMenu.DynamicExtensionActions"
                   class="org.zoocode.jetbrains.extensions.ui.actions.DynamicExtensionActionsGroup"
                   text="Extension Actions"
                   description="Dynamic extension-specific actions" />
        </group>
    </actions>
</idea-plugin>
